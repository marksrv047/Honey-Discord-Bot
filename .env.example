# ========================================================
# DISCORD BOT CREDENTIALS
# ========================================================
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# (Optional) Guild ID for instant slash command registration without waiting 1hr
DISCORD_GUILD_ID=your_test_server_id_here

# ========================================================
# ZERO-COST AI PROVIDER CONFIGURATION
# ========================================================
# Active Provider: "gemini" (Recommended), "groq", or "ollama"
AI_PROVIDER=gemini

# --- OPTION A: Google Gemini Free Tier (No credit card required) ---
# Get 100% free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_free_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- OPTION B: Groq Free Tier ---
# Get free API key at: https://console.groq.com/
GROQ_API_KEY=your_free_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- OPTION C: Ollama (100% Free, Offline, Infinite) ---
# Run locally: "ollama run llama3.1:8b"
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Debugging
DEBUG=false
